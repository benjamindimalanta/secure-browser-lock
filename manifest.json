{
  "manifest_version": 3,
  "name": "Browser Secure",
  "short_name": "BrowserSec",
  "version": "1.0.1",
  "description": "PIN-lock your browser on startup, idle, or demand. Hides tabs until unlock. Data stays on your device.",
  "homepage_url": "https://github.com/benjamindimalanta/secure-browser-lock",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "incognito": "spanning",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "windows",
    "tabGroups",
    "system.display",
    "history",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser Secure",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "setup.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content/lock-overlay.js"],
      "css": ["content/lock-overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
