{
  "manifest_version": 3,
  "name": "Secure Browser Lock",
  "version": "0.7.1",
  "description": "Lock Chrome/Edge/Brave with a PIN. Popup lock, hidden tabs, no history entry.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "incognito": "spanning",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "windows",
    "tabGroups",
    "system.display",
    "history",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser Lock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "setup.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/lock-overlay.js"],
      "css": ["content/lock-overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
